{
  "name": "@verndale/ui-design-library",
  "version": "0.0.0",
  "private": true,
  "description": "Private component library keyed by ui-design-brain canonical slugs. Consumed as a git submodule and imported from source, so projects start from a built component instead of rebuilding it.",
  "license": "UNLICENSED",
  "author": "Verndale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verndale/ui-design-library.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "prepare": "husky",
    "commit": "ai-commit run",
    "pr:create": "ai-pr",
    "lint:commits:last": "commitlint --config node_modules/@verndale/ai-commit/lib/commitlint-preset.cjs --last",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "contracts": "node scripts/check-contracts.cjs",
    "graph:build": "node scripts/graph/build-graph.cjs",
    "graph:view": "node scripts/graph/serve.cjs",
    "graph:navigate": "node scripts/wiki/navigate.cjs",
    "evals:graph": "node scripts/evals/graph-check.cjs",
    "wiki:issue-sync": "node scripts/wiki/refresh-issue-state.cjs",
    "test:stories": "vitest run -c vitest.config.ts",
    "test:stories:watch": "vitest -c vitest.config.ts",
    "test:motion": "vitest run -c vitest.motion.config.ts",
    "test": "pnpm typecheck && pnpm contracts && pnpm test:stories && pnpm test:motion"
  },
  "peerDependencies": {
    "embla-carousel-react": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "10.5.4",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@verndale/ai-commit": "^2.6.3",
    "@verndale/ai-pr": "^1.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "embla-carousel-react": "^8.6.0",
    "husky": "^9.1.7",
    "playwright": "^1.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.0.0",
    "storybook-addon-pseudo-states": "10.5.4",
    "storybook-addon-tag-badges": "3.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
