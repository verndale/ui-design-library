{
  "name": "@verndale/ui-design-library",
  "version": "0.0.0-development",
  "description": "Public React component library keyed by ui-design-brain canonical slugs.",
  "license": "MIT",
  "author": "Verndale",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verndale/ui-design-library.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "uiDesignLibrary": {
    "reuseContractVersion": 2,
    "realizationContractVersion": 1
  },
  "files": [
    "dist",
    "components",
    "src/lib",
    "src/tokens",
    "styles.css",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "exports": {
    "./components/accordion": {
      "types": "./dist/components/accordion/index.d.ts",
      "import": "./dist/components/accordion/index.js"
    },
    "./components/accordion/component.json": "./components/accordion/component.json",
    "./components/alert": {
      "types": "./dist/components/alert/index.d.ts",
      "import": "./dist/components/alert/index.js"
    },
    "./components/alert/component.json": "./components/alert/component.json",
    "./components/avatar": {
      "types": "./dist/components/avatar/index.d.ts",
      "import": "./dist/components/avatar/index.js"
    },
    "./components/avatar/component.json": "./components/avatar/component.json",
    "./components/badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.js"
    },
    "./components/badge/component.json": "./components/badge/component.json",
    "./components/breadcrumbs": {
      "types": "./dist/components/breadcrumbs/index.d.ts",
      "import": "./dist/components/breadcrumbs/index.js"
    },
    "./components/breadcrumbs/component.json": "./components/breadcrumbs/component.json",
    "./components/button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js"
    },
    "./components/button/component.json": "./components/button/component.json",
    "./components/card": {
      "types": "./dist/components/card/index.d.ts",
      "import": "./dist/components/card/index.js"
    },
    "./components/card/component.json": "./components/card/component.json",
    "./components/carousel": {
      "types": "./dist/components/carousel/index.d.ts",
      "import": "./dist/components/carousel/index.js"
    },
    "./components/carousel/component.json": "./components/carousel/component.json",
    "./components/image": {
      "types": "./dist/components/image/index.d.ts",
      "import": "./dist/components/image/index.js"
    },
    "./components/image/component.json": "./components/image/component.json",
    "./components/in-page-navigation": {
      "types": "./dist/components/in-page-navigation/index.d.ts",
      "import": "./dist/components/in-page-navigation/index.js"
    },
    "./components/in-page-navigation/component.json": "./components/in-page-navigation/component.json",
    "./components/link": {
      "types": "./dist/components/link/index.d.ts",
      "import": "./dist/components/link/index.js"
    },
    "./components/link/component.json": "./components/link/component.json",
    "./components/modal": {
      "types": "./dist/components/modal/index.d.ts",
      "import": "./dist/components/modal/index.js"
    },
    "./components/modal/component.json": "./components/modal/component.json",
    "./components/quote": {
      "types": "./dist/components/quote/index.d.ts",
      "import": "./dist/components/quote/index.js"
    },
    "./components/quote/component.json": "./components/quote/component.json",
    "./components/rich-text": {
      "types": "./dist/components/rich-text/index.d.ts",
      "import": "./dist/components/rich-text/index.js"
    },
    "./components/rich-text/component.json": "./components/rich-text/component.json",
    "./components/search-input": {
      "types": "./dist/components/search-input/index.d.ts",
      "import": "./dist/components/search-input/index.js"
    },
    "./components/search-input/component.json": "./components/search-input/component.json",
    "./components/search-overlay": {
      "types": "./dist/components/search-overlay/index.d.ts",
      "import": "./dist/components/search-overlay/index.js"
    },
    "./components/search-overlay/component.json": "./components/search-overlay/component.json",
    "./components/section-header": {
      "types": "./dist/components/section-header/index.d.ts",
      "import": "./dist/components/section-header/index.js"
    },
    "./components/section-header/component.json": "./components/section-header/component.json",
    "./components/slider": {
      "types": "./dist/components/slider/index.d.ts",
      "import": "./dist/components/slider/index.js"
    },
    "./components/slider/component.json": "./components/slider/component.json",
    "./components/stat": {
      "types": "./dist/components/stat/index.d.ts",
      "import": "./dist/components/stat/index.js"
    },
    "./components/stat/component.json": "./components/stat/component.json",
    "./components/tabs": {
      "types": "./dist/components/tabs/index.d.ts",
      "import": "./dist/components/tabs/index.js"
    },
    "./components/tabs/component.json": "./components/tabs/component.json",
    "./components/toast": {
      "types": "./dist/components/toast/index.d.ts",
      "import": "./dist/components/toast/index.js"
    },
    "./components/toast/component.json": "./components/toast/component.json",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "commit": "ai-commit run",
    "pr:create": "ai-pr",
    "lint:commits:last": "commitlint --config node_modules/@verndale/ai-commit/lib/commitlint-preset.cjs --last",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "exports:sync": "node scripts/build-exports.cjs --write",
    "exports:check": "node scripts/build-exports.cjs",
    "exports:dist": "node scripts/build-exports.cjs --dist",
    "build": "pnpm exports:check && node scripts/clean-dist.cjs && tsc -p tsconfig.build.json && pnpm exports:dist",
    "prepack": "pnpm test && pnpm build",
    "release": "semantic-release",
    "release:preflight": "node scripts/check-release-commit.cjs",
    "release:preflight:selftest": "node scripts/check-release-commit.selftest.cjs",
    "typecheck": "tsc --noEmit && pnpm figma:typecheck",
    "lint": "eslint components src",
    "architecture": "node scripts/check-component-architecture.cjs",
    "architecture:selftest": "node scripts/check-component-architecture.selftest.cjs",
    "contracts": "node scripts/check-contracts.cjs && pnpm figma:contracts && node scripts/build-accessibility-report.cjs",
    "contracts:selftest": "node scripts/check-contracts.selftest.cjs && pnpm figma:contracts:selftest && pnpm figma:live:selftest",
    "figma:typecheck": "tsc -p tsconfig.figma.json",
    "figma:contracts": "node scripts/check-figma-contracts.cjs",
    "figma:contracts:selftest": "node scripts/check-figma-contracts.selftest.cjs",
    "figma:live": "node scripts/check-figma-live.cjs",
    "figma:live:if-token": "node scripts/check-figma-live.cjs --if-token",
    "figma:live:selftest": "node scripts/check-figma-live.selftest.cjs",
    "figma:connect:parse": "figma connect parse --config figma.config.json --exit-on-unreadable-files",
    "figma:validate": "pnpm figma:typecheck && pnpm figma:contracts && pnpm figma:connect:parse && pnpm figma:live:if-token",
    "accessibility:report": "node scripts/build-accessibility-report.cjs",
    "graph:build": "node scripts/graph/build-graph.cjs",
    "graph:view": "node scripts/graph/serve.cjs",
    "graph:navigate": "node scripts/wiki/navigate.cjs",
    "graphify:sync": "node scripts/graph/sync-graphify.cjs",
    "evals:graph": "node scripts/evals/graph-check.cjs",
    "wiki:issue-sync": "node scripts/wiki/refresh-issue-state.cjs",
    "test:stories": "vitest run -c vitest.config.ts",
    "test:stories:watch": "vitest -c vitest.config.ts",
    "accessibility": "vitest run -c vitest.config.ts",
    "test:a11y:webkit": "vitest run -c vitest.webkit.config.ts",
    "test:a11y:modes": "vitest run -c vitest.a11y.config.ts",
    "test:motion": "vitest run -c vitest.motion.config.ts",
    "test:ssr": "vitest run -c vitest.ssr.config.ts",
    "test:next": "node scripts/test-next.cjs",
    "test": "pnpm typecheck && pnpm lint && pnpm architecture && pnpm architecture:selftest && pnpm contracts && pnpm contracts:selftest && pnpm accessibility:report && pnpm release:preflight:selftest && pnpm exports:check && pnpm test:ssr && pnpm accessibility && pnpm test:a11y:webkit && pnpm test:a11y:modes && pnpm test:motion",
    "verify": "pnpm test && pnpm build && pnpm test:next"
  },
  "peerDependencies": {
    "embla-carousel-react": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@figma/code-connect": "2.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "10.5.4",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@verndale/ai-commit": "^2.6.3",
    "@verndale/ai-pr": "^1.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "next": "16.2.12",
    "playwright": "^1.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semantic-release": "25.0.9",
    "storybook": "^10.0.0",
    "storybook-addon-pseudo-states": "10.5.4",
    "storybook-addon-tag-badges": "3.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
